<!DOCTYPE html>

<!-- File origin: VS1LAB A1a -->

<!DOCTYPE html>

<!-- File origin: VS1LAB A1a -->

<html lang="en">

<head>
    <!-- Leaflet CSS and JavaScript (in this order) -->
    <link rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GeoTagApp</title>
    <link rel="stylesheet" href="./stylesheets/style.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body>
    <header class="header">
        <img src="./images/location.png" class="header__image" alt="an image of a map and location">
        <h1 class="header__title">GeoTagApp</h1>
        <nav class="header__navigation">
            <a href="#">About</a> | <a href="#">Help</a> | <a href="/">Home</a>
        </nav>
    </header>

    <main class="main row">
        <section class="main__tagging tagging col-4">
            <h2>Tagging</h2>

            <!-- ############### VS1Lab 1a Form 1 Start -->
            <form id="tag-form" action="/tagging" method="post">
                <!-- ... your code here ... -->
                 <fieldset>
                    <legend>Add a new GeoTag</legend><br>

                    <label for="tagLat" >Latitude: </label> <br>
                    <input type="text" id="tagLat" name="latitude" value="<%= currentLatitude %>" readonly/> <br>

                    <label for="tagLong">Longitude: </label> <br>
                    <input type="text" id="tagLong" name="longitude" value="<%= currentLongitude %>" readonly/><br>

                    <label for="tagName">Name: </label> <br>
                    <input type="text" id="tagName" name="name" placeholder="e.g. Bester Döner" maxlength="10" required pattern="^[A-Za-z]{0,10}$"/> <br>

                    <label for="atagHash">Hashtag: </label> <br>
                    <input type="text" id="tagHash" name="hashtag" placeholder="e.g. #Döner" pattern="^#[A-Za-z]{0,10}$"/> <br>
            
                    <button type="submit">Add Tag</button><br>
            
                </fieldset>

            </form>
            <!-- ############### VS1Lab 1a Form 1 End -->

        </section>

        <section class="main__discovery discovery col-8">
            <h2 class="discovery__title">Discovery</h2>

            <!-- ############### VS1Lab 1a Form 2 Start -->
            <form class="discovery__search" id="discoveryFilterForm" action="/discovery" method="post">
                <!-- ... your code here ... -->
                <fieldset>
                    <legend>Search</legend>
                    <label for="search">Search term or keywords: </label><br>
                    <input type="search" id="searchterm" name="searchTerm" placeholder="e.g. Karlsruhe" maxlength="10"> <br>
                    <input type="hidden" id="tagLatHidden" name="latitude" value="<%= currentLatitude %>">
                    <input type="hidden" id="tagLongHidden" name="longitude" value="<%= currentLongitude %>">
                    <button type="submit">Search</button>
                </fieldset>

            </form>
            <!-- ############### VS1Lab 1a Form 2 End -->

            <div class="discovery__wrapper row">
                <div class="discovery__taglist">
                    <ul class="discovery__results" id="discoveryResults">
                        <% if (taglist !== undefined) taglist.forEach(function(gtag) { %>
        <li><%= gtag.name %> ( <%= gtag.latitude %>,<%= gtag.longitude %>) <%= gtag.hashtag %> </li>
    <% }); %>
                    </ul>
                </div>

                <div id="map" class="discovery__map col-8" data-tags='<%= JSON.stringify(taglist) %>'>
                    <img src="./images/mapview.jpg" alt="a map with locations" id="bild" />
                    <p>Result map</p>
                </div>
            </div>
        </section>

    </main>

    <footer class="footer">
        <span>(c) 2021/22 HKA_IWI_VSYS</span>
    </footer>
    <!-- Load JavaScripts
    ================================================== -->
    <!-- Placed at the end of the document so the pages load faster -->
    <script src="./javascripts/map-manager.js"></script>
    <script src="./javascripts/location-helper.js"></script>
    <script src="./javascripts/geotagging.js"></script>
    
</body>

</html>